{
  "name": "@egytronic/studio",
  "private": true,
  "type": "module",
  "description": "Agent-driven print studio: paginated documents from a JSON model. Emits self-contained HTML that prints to PDF.",
  "bin": {
    "egx-studio": "./cli.js"
  },
  "scripts": {
    "mcp": "node mcp.js",
    "verify": "node scripts/verify.mjs",
    "doc": "node cli.js doc examples/doc-proposal.json --out proposal.html",
    "catalog": "node cli.js catalog",
    "art": "node scripts/gen-pixelfx.mjs",
    "quote": "node cli.js doc examples/doc-quote.json --out quote.html",
    "fonts": "node scripts/gen-fonts.mjs",
    "kitchen": "node cli.js doc examples/doc-kitchen.json --out kitchen.html"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "pagedjs": "^0.4.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "pdfjs-dist": "^4.7.76",
    "playwright": "^1.49.1"
  }
}
